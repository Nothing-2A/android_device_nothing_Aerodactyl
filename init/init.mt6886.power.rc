on early-init
    # boot perf. tune
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "performance"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "performance"

    write /proc/sys/kernel/sched_pelt_multiplier 1

on init
    # Make foreground and background I/O priority different. none-to-rt was
    # introduced in kernel 5.14. promote-to-rt was introduced in kernel 6.5.
    # Write none-to-rt first and promote-to-rt next to support both older and
    # newer kernel versions.
    write /dev/blkio/blkio.prio.class none-to-rt
    write /dev/blkio/blkio.prio.class promote-to-rt

    # F2FS
    write /dev/sys/fs/by-name/userdata/data_io_flag 56
    write /dev/sys/fs/by-name/userdata/node_io_flag 56

    # Block
    write /dev/sys/block/by-name/rootdisk/queue/iostats 0
    write /dev/sys/block/by-name/rootdisk/queue/nr_requests 256

    # UFS
    write /sys/devices/platform/soc/112b0000.ufshci/clkgate_enable 0
    write /sys/devices/platform/soc/112b0000.ufshci/wb_on 0
    write /sys/devices/platform/soc/112b0000.ufshci/enable_wb_buf_flush 0

    # adjust PCP high level
    write /proc/sys/vm/percpu_pagelist_high_fraction 430

    # disable proactive compaction
    write /proc/sys/vm/compaction_proactiveness 0
    write /proc/sys/vm/swappiness 60

    # memory reserve tuning
    write /proc/sys/vm/min_free_kbytes 27386
    write /proc/sys/vm/lowmem_reserve_ratio "0 0 0"

    # disable khugepaged
    write /sys/kernel/mm/transparent_hugepage/enabled "never"

    # Set teo as cpu idle governor
    write /sys/devices/system/cpu/cpuidle/current_governor teo

    # Boot time fs tuning
    write /sys/block/sda/queue/scheduler mq-deadline

    # zRAM
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0

    # RT uclamp setting
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0

on charger
    # Keep one LITTLE and one big
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/devices/system/cpu/cpu4/online 0
    write /sys/devices/system/cpu/cpu5/online 0
    write /sys/devices/system/cpu/cpu7/online 0

    # F2FS
    write /dev/sys/fs/by-name/userdata/data_io_flag 8
    write /dev/sys/fs/by-name/userdata/node_io_flag 8
    write /dev/sys/fs/by-name/userdata/max_io_bytes 524288
    write /dev/sys/fs/by-name/userdata/min_hot_blocks 0

    # Priority
    write /dev/sys/fs/by-name/userdata/adjust_lock_priority 32
    write /dev/sys/fs/by-name/userdata/critical_task_priority 100

    # Block
    write /dev/sys/block/by-name/rootdisk/queue/nr_requests 128
    write /dev/sys/block/by-name/rootdisk/queue/rq_affinity 2

on post-fs
    # dex2oat settings
    setprop dalvik.vm.dex2oat-cpu-set 2,3,4,5
    setprop dalvik.vm.dex2oat-threads 4

on property:sys.boot_completed=1
    # restore boot perf. tune
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "schedutil"

    # F2FS
    write /dev/sys/block/by-name/userdata/queue/read_ahead_kb 128
    write /dev/sys/fs/by-name/userdata/data_io_flag 8
    write /dev/sys/fs/by-name/userdata/node_io_flag 8
    write /dev/sys/fs/by-name/userdata/max_io_bytes 524288
    write /dev/sys/fs/by-name/userdata/min_hot_blocks 0

    # Block
    write /dev/sys/block/by-name/rootdisk/queue/iostats 1
    write /dev/sys/block/by-name/rootdisk/queue/read_ahead_kb 128
    write /dev/sys/block/by-name/rootdisk/queue/nr_requests 128
    write /dev/sys/block/by-name/rootdisk/queue/rq_affinity 2

    # UFS
    write /sys/devices/platform/soc/112b0000.ufshci/clkgate_enable 1

    # zRAM
    swapon_all /vendor/etc/fstab.enableswap

    # Adjust watermark level
    write /proc/sys/vm/watermark_scale_factor 200

    # Set VM settings
    write /proc/sys/vm/dirty_expire_centisecs 200
    write /proc/sys/vm/dirty_background_ratio 5

    # Setup final cpuset
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/cpus 0-6
    write /dev/cpuset/foreground_window/cpus 0-6
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/restricted/cpus 0-3
    write /dev/cpuset/camera-daemon/cpus 0-7

    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

service vendor.gralloc-v2 /vendor/bin/hw/android.hardware.graphics.allocator-V2-service-mediatek
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    onrestart restart vendor.hwcomposer
    onrestart restart camerahalserve
    task_profiles ProcessCapacityHigh HighPerformance
    override

service vendor.hwcomposer /vendor/bin/hw/android.hardware.graphics.composer@3.4-service
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ProcessCapacityHigh HighPerformance
    override
